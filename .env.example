# Vayu — optional server-side configuration.
# Copy to `.env` for local `vercel dev`. Nothing here is required: without these
# values the app falls back to deterministic, clearly-labelled behaviour.

# Enables AI chat (/api/chat) and the optional AI daily brief (/api/plan).
# Read only inside api/*.ts from process.env; never sent to the browser.
GEMINI_API_KEY=
# Defaults to gemini-2.0-flash in api/chat.ts and api/plan.ts.
GEMINI_MODEL=gemini-2.0-flash

# Enables official CPCB-linked AQI via data.gov.in (/api/aqi).
# The resource must expose an AQI field; pollutant-only resources are reported
# as unavailable rather than converted into an official AQI.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=
