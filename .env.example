# Vayu — optional server-side configuration.
# Copy to `.env` for local `vercel dev`. Nothing here is required: without these
# values the app falls back to deterministic, clearly-labelled behaviour.
#
# Verify what you configured with:  npm run check:providers

# Enables AI chat (/api/chat) and the optional AI daily brief (/api/plan).
# Read only inside api/*.ts from process.env; never sent to the browser.
GEMINI_API_KEY=
# Defaults to gemini-3.5-flash-lite in api/chat.ts and api/plan.ts.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared API rate limits (Redis REST fixed-window counters).
# Without both values, the API uses a bounded per-instance limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enables official CPCB station data via data.gov.in (/api/aqi).
# The default resource is the CPCB "Real time Air Quality Index from various
# locations" dataset. It publishes one row per pollutant per station and has no
# AQI field, so Vayu displays the official station concentrations and states
# that it does not derive an official AQI from them.
# Get a personal key at https://data.gov.in (the public sample key is heavily
# rate-limited and returns at most 10 records).
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
